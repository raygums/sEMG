// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH
// ============================================

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hashed
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// GESTURE MANAGEMENT
// ============================================

model Gesture {
  id          String    @id @default(cuid())
  name        String    @unique
  label       String
  description String?
  videoUrl    String?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]
}

// ============================================
// SESSION CONFIGURATION
// ============================================

model SessionConfig {
  id                  String    @id @default(cuid())
  name                String    @default("Default")
  preparationDuration Int       @default(3)
  actionDuration      Int       @default(5)
  restDuration        Int       @default(3)
  repetitionCount     Int       @default(10)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
}

// ============================================
// SESSION & EVENT LOGGING
// ============================================

model Session {
  id              String        @id @default(cuid())
  participantId   String?       // Tambahkan ini
  participantName String?
  age             Int?          // Tambahkan ini
  gender          String?       // Tambahkan ini
  dominantHand    String?       // Tambahkan ini
  condition       String?       // Tambahkan ini
  gestureId       String
  gesture         Gesture       @relation(fields: [gestureId], references: [id])
  configId        String
  config          SessionConfig @relation(fields: [configId], references: [id])
  status          String        @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  events          EventLog[]
  emgSamples      EmgSample[]
  gatewayEvents   GatewayEvent[]
}

model EventLog {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType       String
  repetitionNum   Int?
  timestamp       DateTime @default(now())
  clientTimestamp  BigInt
  metadata        Json?
}

// ============================================
// EMG SENSOR SAMPLES (from BLE gateway)
// ============================================

model EmgSample {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Device-side timestamp: micros() on the nRF52840, as sent in the BLE packet.
  // NOTE: this wraps around every ~71 minutes (uint32 overflow), so the gateway
  // also stamps a wall-clock receivedAt for ordering/cross-referencing.
  deviceTimestampUs BigInt

  // Wall-clock time when the gateway received this sample (ms since epoch),
  // used to align EMG samples with EventLog entries from the session runner.
  receivedAt    DateTime @default(now())

  // Raw and envelope values per channel (6 channels from "Hello SEMG by Cheez").
  // Stored as Float[] for compactness; index 0..5 corresponds to PINS[0..5]
  // (A0..A5) in the firmware.
  raw           Float[]
  envelope      Float[]

  createdAt     DateTime @default(now())

  @@index([sessionId, deviceTimestampUs])
}

// ============================================
// GATEWAY CONNECTIVITY LOG (BLE disconnects)
// ============================================

// Records a single disconnect -> reconnect cycle reported by the Python
// gateway. `reconnectedAt` is null while the gap is still open (i.e. the
// gateway is currently disconnected and SessionRunner should be paused).
// During preprocessing, any EmgSample with no clean coverage inside
// [disconnectedAt, reconnectedAt] indicates a data gap that should be
// excluded or flagged rather than treated as continuous signal.
model GatewayEvent {
  id             String    @id @default(cuid())
  sessionId      String
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  disconnectedAt DateTime  @default(now())
  reconnectedAt  DateTime?

  // Optional free-form context from the gateway (e.g. exception message,
  // reconnect attempt count) for debugging connectivity issues later.
  note           String?

  createdAt      DateTime  @default(now())

  @@index([sessionId, disconnectedAt])
}
