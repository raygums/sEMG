// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTH
// ============================================

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hashed
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// GESTURE MANAGEMENT
// ============================================

model Gesture {
  id          String    @id @default(cuid())
  name        String    @unique
  label       String
  description String?
  videoUrl    String?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]
}

// ============================================
// SESSION CONFIGURATION
// ============================================

model SessionConfig {
  id                  String    @id @default(cuid())
  name                String    @default("Default")
  preparationDuration Int       @default(3)
  actionDuration      Int       @default(5)
  restDuration        Int       @default(3)
  repetitionCount     Int       @default(10)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
}

// ============================================
// SESSION & EVENT LOGGING
// ============================================

model Session {
  id              String        @id @default(cuid())
  participantId   String?
  participantName String?
  age             Int?
  gender          String?
  dominantHand    String?
  condition       String?
  gestureId       String
  gesture         Gesture       @relation(fields: [gestureId], references: [id])
  configId        String
  config          SessionConfig @relation(fields: [configId], references: [id])
  status          String        @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  events          EventLog[]
  emgRecords      EmgRecord[]
}

model EventLog {
  id               String   @id @default(cuid())
  sessionId        String
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType        String
  repetitionNum    Int?
  timestamp        DateTime @default(now())
  clientTimestamp  BigInt
  metadata         Json?
}

// ============================================
// EMG SENSOR RECORDS (from Serial bridge)
// ============================================

enum Phase {
  PREPARATION
  ACTION
  REST
}

model EmgRecord {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Pure sequence counter within a session: 0, 1, 2, ... n. Never ambiguous,
  // independent of any clock. Use this for ordering/windowing.
  sampleIndex Int

  // Milliseconds elapsed since bridge received POST /session/start.
  // Generated entirely by Python Bridge (time.perf_counter()), not firmware.
  // Reset to 0 at the start of each new session. Safe from overflow for
  // sessions up to ~24 days (Int 32-bit max ~2.1 billion ms).
  elapsedMs   Int

  // Supervised learning label: which phase of the gesture protocol this
  // sample belongs to.
  phase       Phase

  // True for the first N samples received after the bridge's local phase
  // state changes (see TRANSITION_GUARD_SAMPLES in emg_bridge.py). These
  // samples may carry a stale phase label due to the local HTTP round-trip
  // between Next.js and the bridge -- kept (not dropped) so preprocessing
  // can choose to exclude or use them.
  isTransition Boolean @default(false)

  // Raw signal per channel (6 channels from "Hello SEMG by Cheez").
  // r1..r6 correspond to PINS[0..5] (A0..A5) in the firmware.
  r1 Float
  r2 Float
  r3 Float
  r4 Float
  r5 Float
  r6 Float

  // Processed/envelope signal per channel, same channel order as r1..r6.
  p1 Float
  p2 Float
  p3 Float
  p4 Float
  p5 Float
  p6 Float

  // Wall-clock time when the row was inserted (metadata only -- not the
  // source of truth for ordering; use sampleIndex/elapsedMs for that).
  createdAt   DateTime @default(now())

  @@index([sessionId, phase])
  @@index([sessionId, sampleIndex])
}
